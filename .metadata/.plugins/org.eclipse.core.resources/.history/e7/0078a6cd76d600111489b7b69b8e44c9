server:
  port: 8082
  
  
spring:
  application:
    name: EMPLOYEE-SERVICE
  profiles:
    active:
    - dev
  config:
    import:
      - optional:configserver:http://localhost:8888 
eureka:
  client:
    service-url:
      defaultZone : http://localhost:8761/eureka/
  instance:
    instance-id: ${spring.application.name}:${server.port}
    
management:
  endpoints:
    web:
      exposure:
        include: "health,info,refresh,env"
      
